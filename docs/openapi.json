    "/api/board": {
      "get": {
        "operationId": "listBoard",
        "tags": ["Board"],
        "summary": "공유 게시판 목록 조회",
        "description": "A signed anonymous user (user:null) is allowed. Browser login cookies alone are not BFF authentication.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
