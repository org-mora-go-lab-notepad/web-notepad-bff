  },
  "components": {
    "securitySchemes": {
      "GatewayContext": {
        "type": "apiKey",
        "in": "header",
        "name": "x-notepad-context",
        "description": "Base64url of signed GatewayContext JSON, not a server secret."
      },
      "GatewaySignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-notepad-signature",
        "description": "Per-request HMAC signature, never enter NOTEPAD_BFF_SECRET here."
      },
      "BrowserToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "60-second origin-bound credential issued by web-notepad /api/auth/bff from the Kakao session. Never enter a server secret."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "profileImageUrl": {
            "type": "string"
          }
        },
        "required": ["id", "nickname"]
      },
      "NoteTab": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          },
          "savedContent": {
            "type": "string"
          },
          "bookmarked": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          },
          "tabColor": {
            "type": "string"
          },
          "dashboardStatus": {
            "type": "string",
            "enum": ["note", "todo", "ready", "doing", "done"]
          },
          "selectedLines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "updatedAt": {
            "type": "integer"
          }
        },
        "required": ["id", "content"]
      },
      "Bookmark": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "sourceTabId": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "selectedLines": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "tabColor": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          }
        },
        "required": ["id", "sourceTabId", "content"]
      },
      "SharedGroupData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shared-[0-9a-fA-F-]{36}$"
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "createdAt": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          },
          "tabs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteTab"
            }
          },
          "bookmarks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bookmark"
            }
          },
          "dashboardStatusNames": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["id", "name", "tabs", "bookmarks"]
      },
      "SharedRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shared-[0-9a-fA-F-]{36}$"
          },
          "ownerId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "data": {
            "$ref": "#/components/schemas/SharedGroupData"
          },
          "updatedAt": {
            "type": "integer"
          },
          "sharingActive": {
            "type": "boolean"
          },
          "shareVersion": {
            "type": "integer"
          }
        },
        "required": ["id", "ownerId", "revision", "data"]
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "snapshot": {
            "type": "string",
            "description": "JSON serialized snapshot; groups, closedTabs and settings are required."
          },
          "createdAt": {
            "type": "integer"
          }
        },
        "required": ["eventId", "snapshot", "createdAt"]
      },
      "MovedTab": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string"
          }
        },
        "required": ["id", "content"]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "groupId": {
            "type": "string",
            "pattern": "^shared-[0-9a-fA-F-]{36}$"
          },
          "tabId": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "actorName": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "unread": {
            "type": "boolean"
          }
        }
      },
      "BoardPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shared-[0-9a-fA-F-]{36}$"
          },
          "viewerRole": {
            "type": "string",
            "nullable": true,
            "enum": ["owner", "member", null]
          },
          "groupName": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "noteCount": {
            "description": "Total nonblank tabs across Note, To Do, Ready, Doing, and Done, including tabs closed in the editor.",
            "type": "integer"
          },
          "bookmarkCount": {
            "type": "integer"
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteTab"
            }
          },
          "memberCount": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          },
          "shareLink": {
            "$ref": "#/components/schemas/ShareLink"
          },
          "inviteUrl": {
            "type": "string",
            "format": "uri",
            "description": "BrowserToken 인증 시 반환하는 프런트 초대 URL"
          }
        },
        "required": ["id", "groupName", "notes"],
        "anyOf": [
          {
            "required": ["shareLink"]
          },
          {
            "required": ["inviteUrl"]
          }
        ]
      },
      "GroupEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$",
            "description": "ungrouped cannot be shared."
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "createdAt": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          },
          "tabs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteTab"
            }
          },
          "bookmarks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bookmark"
            }
          },
          "dashboardStatusNames": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "activeTabId": {
            "type": "string"
          },
          "rightTabIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activeRightTabId": {
            "type": "string",
            "nullable": true
          },
          "leftBottomTabIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activeLeftBottomTabId": {
            "type": "string",
            "nullable": true
          },
          "rightBottomTabIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activeRightBottomTabId": {
            "type": "string",
            "nullable": true
          },
          "activePane": {
            "type": "string",
            "enum": ["left", "right", "left-bottom", "right-bottom"]
          },
          "splitRatio": {
            "type": "number"
          },
          "leftRowRatio": {
            "type": "number"
          },
          "rightRowRatio": {
            "type": "number"
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "tabs",
          "bookmarks",
          "activeTabId",
          "rightTabIds",
          "leftBottomTabIds",
          "rightBottomTabIds"
        ]
      },
      "HistoryUpdate": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Generate a new UUID for each logical update; repeat IDs are idempotent."
          },
          "snapshot": {
            "type": "string",
            "maxLength": 5000000,
            "description": "JSON string with groups, closedTabs and settings. Missing existing tabs are protected."
          },
          "baseEventId": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string"
          },
          "deletedTabIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 1000,
            "default": []
          },
          "emptyClosedTabIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 1000,
            "default": [],
            "description": "Only explicit individual empty-close intent at the matching revision. No automatic cleanup."
          },
          "movedTabs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovedTab"
            }
          }
        },
        "required": ["eventId", "snapshot"]
      },
      "GroupUpdate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shared-[0-9a-fA-F-]{36}$"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "$ref": "#/components/schemas/SharedGroupData"
          },
          "deletedTabIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 1000,
            "default": []
          },
          "movedTabIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 1000,
            "default": []
          },
          "emptyClosedTabIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 1000,
            "default": []
          },
          "movedTabs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovedTab"
            }
          },
          "confirmedDeletion": {
            "type": "boolean",
            "default": false,
            "description": "Only after explicit authorization for the targeted deletion. Moving and closing tabs do not imply bulk deletion."
          }
        },
        "required": ["id", "baseRevision", "data"]
      },
      "GatewayContext": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [1]
          },
          "issuedAt": {
            "type": "integer",
            "description": "Unix milliseconds; valid for 60 seconds (5 seconds future skew)."
          },
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Original frontend URL including path and query."
          },
          "method": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "nullable": true
          },
          "contentType": {
            "type": "string",
            "nullable": true
          },
          "bodyHash": {
            "type": "string",
            "description": "SHA-256 hex of exact UTF-8 body bytes; empty bytes for GET/HEAD."
          },
          "verifiedShareLink": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ShareLink"
              }
            ],
            "nullable": true,
            "description": "Only frontend-attested /api/groups/join token claims, covered by the gateway HMAC and original request body hash. BFF still checks enabled/token_version in DB."
          }
        },
        "required": [
          "version",
          "issuedAt",
          "user",
          "url",
          "method",
          "origin",
          "contentType",
          "bodyHash"
        ]
      },
      "ShareLink": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^shared-[0-9a-fA-F-]{36}$"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["groupId", "version"],
        "description": "Unsigned descriptor for frontend signing with its unchanged AUTH_SECRET. Never a browser join credential."
      }
    }
  }
}
