{
  "openapi": "3.0.3",
  "info": {
    "title": "Web Notepad BFF API",
    "version": "1.0.1",
    "description": "카카오 OAuth와 세션은 web-notepad에 유지합니다. 브라우저는 /api/auth/bff에서 받은 60초짜리 Origin 바인딩 Bearer 토큰으로 BFF 업무 API를 직접 호출합니다. 서버 호출은 기존 게이트웨이 서명을 사용할 수 있습니다. 서버 비밀키는 브라우저에 입력하지 않습니다. DB 변경 요청은 실제 데이터를 변경하므로 테스트는 격리된 로컬 DB에서만 수행합니다."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current BFF origin (server-signed requests)"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "History"
    },
    {
      "name": "Groups"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Board"
    }
  ],
  "security": [
    {
      "GatewayContext": [],
      "GatewaySignature": []
    },
    {
      "BrowserToken": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Health"],
        "summary": "서비스 상태 조회",
        "description": "Checks the service process without accessing or changing the database.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": ["web-notepad-bff"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "required": ["service", "status"]
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/notepad/history": {
      "get": {
        "operationId": "getHistory",
        "tags": ["History"],
        "summary": "개인 최신 이력 조회",
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "latest": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/HistoryEntry"
                        }
                      ],
                      "nullable": true
                    },
                    "count": {
                      "type": "integer"
                    }
                  },
                  "required": ["latest", "count"]
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid gateway signature or login session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database or backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "saveHistory",
        "tags": ["History"],
        "summary": "개인 스냅샷 저장",
        "description": "Preserves existing records. Omitted tabs require verified transfer/deletion intent. Never automatically cleans up short or empty notes.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": {
                      "type": "boolean"
                    }
                  },
                  "required": ["saved"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid gateway signature or login session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid Origin, owner or account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict; latest server snapshot and protected IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": ["Conflict"]
                    },
                    "latest": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/HistoryEntry"
                        }
                      ],
                      "nullable": true
                    },
                    "protectedTabIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["error", "latest"]
                }
              }
            }
          },
          "503": {
            "description": "Database or backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoryUpdate"
              }
            }
          }
        }
      }
    },
    "/api/groups": {
      "get": {
        "operationId": "listGroups",
        "tags": ["Groups"],
        "summary": "참여 중인 공유 그룹 조회",
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SharedRecord"
                      }
                    }
                  },
                  "required": ["groups"]
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid gateway signature or login session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database or backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/share": {
      "post": {
        "operationId": "shareGroup",
        "tags": ["Groups"],
        "summary": "공유 링크 생성 또는 재사용",
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "group": {
                      "$ref": "#/components/schemas/GroupEntry"
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "shareLink": {
                      "$ref": "#/components/schemas/ShareLink"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "BrowserToken 인증 시 반환하는 프런트 공유 URL"
                    }
                  },
                  "required": ["group", "revision"],
                  "anyOf": [
                    {
                      "required": ["shareLink"]
                    },
                    {
                      "required": ["url"]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid gateway signature or login session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid Origin, owner or account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database or backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "group": {
                    "$ref": "#/components/schemas/GroupEntry"
                  }
                },
                "required": ["group"]
              }
            }
          }
        }
      }
    },
    "/api/groups/join": {
      "post": {
        "operationId": "joinGroup",
        "tags": ["Groups"],
        "summary": "서명된 초대 링크로 참여",
        "description": "Requires verifiedShareLink in the signed gateway context after frontend verification of the original token. An unverified raw token alone is rejected.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "group": {
                      "$ref": "#/components/schemas/SharedRecord"
                    }
                  },
                  "required": ["group"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid gateway signature or login session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid Origin, owner or account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Group unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database or backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "share query parameter from the original frontend invite URL."
                  }
                },
                "required": ["token"]
              }
            }
          }
        }
      }
    },
    "/api/groups/update": {
      "post": {
        "operationId": "updateGroup",
        "tags": ["Groups"],
        "summary": "공유 그룹 변경 저장",
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "group": {
                      "$ref": "#/components/schemas/SharedRecord"
                    }
                  },
                  "required": ["group"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or payload",
